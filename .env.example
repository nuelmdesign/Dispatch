# Copy this file to .env.local and fill in the values.
# .env.local stays on your computer and is never committed to GitHub.

# The web address the app runs on (http://localhost:3000 while building)
NEXT_PUBLIC_APP_URL=

# Supabase: database, login and image storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend: sending email (needed from slice 3)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# A long random string used to sign unsubscribe links (needed from slice 5)
UNSUBSCRIBE_SECRET=

# Email addresses allowed to sign in, separated by commas
ALLOWED_EMAILS=

# A long random string that protects the scheduled-send job (needed from slice 6)
CRON_SECRET=
